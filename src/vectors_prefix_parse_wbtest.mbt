///|
/// Every `prefix_parse_cases` row, in one array.
fn prefix_parse_cases() -> Array[(String, Bool, String, String)] {
  let all : Array[(String, Bool, String, String)] = []
  all.append(prefix_parse_cases_1()[:])
  all.append(prefix_parse_cases_2()[:])
  all.append(prefix_parse_cases_3()[:])
  all
