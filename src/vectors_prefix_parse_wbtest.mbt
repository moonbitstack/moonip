      "::ffff:255.255.255.255/128", true, "::ffff:255.255.255.255/128", "::ffff:255.255.255.255/128",
    ),
    ("::ffff:c000:0280/96", false, "", "::ffff:0.0.0.0/96"),
    ("::ffff:ffff/128", true, "::ffff:ffff/128", "::ffff:ffff/128"),
    ("Addr.Prefix/4", false, "", ""),
    ("Addr.Prefix/6", false, "", ""),
    ("Addr.Zone/4", false, "", ""),
    ("Addr.Zone/6", false, "", ""),
    ("Addr.Zone/6zone", false, "", ""),
    ("a000::/4", true, "a000::/4", "a000::/4"),
  ]
}

